{
  "$schema": "https://glion.dev/schemas/hl7v2/v1.json#/definitions/Datatype",
  "id": "XON",
  "version": "2.4",
  "kind": "composite",
  "title": "extended composite name and identification number for organizations",
  "components": [
    {
      "sequence": 1,
      "name": "organization name",
      "datatypeId": "ST"
    },
    {
      "sequence": 2,
      "name": "organization name type code",
      "datatypeId": "IS"
    },
    {
      "sequence": 3,
      "name": "ID number (NM)",
      "datatypeId": "NM"
    },
    {
      "sequence": 4,
      "name": "check digit (NM)",
      "datatypeId": "NM"
    },
    {
      "sequence": 5,
      "name": "code identifying the check digit scheme employed",
      "datatypeId": "ID"
    },
    {
      "sequence": 6,
      "name": "assigning authority",
      "datatypeId": "HD"
    },
    {
      "sequence": 7,
      "name": "identifier type code (IS)",
      "datatypeId": "IS"
    },
    {
      "sequence": 8,
      "name": "assigning facility ID",
      "datatypeId": "HD"
    },
    {
      "sequence": 9,
      "name": "Name Representation code",
      "datatypeId": "ID"
    }
  ]
}
