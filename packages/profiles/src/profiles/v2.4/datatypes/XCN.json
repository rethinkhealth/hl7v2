{
  "$schema": "https://glion.dev/schemas/hl7v2/v1.json#/definitions/Datatype",
  "id": "XCN",
  "version": "2.4",
  "kind": "composite",
  "title": "extended composite ID number and name for persons",
  "components": [
    {
      "sequence": 1,
      "name": "ID number (ST)",
      "datatypeId": "ST"
    },
    {
      "sequence": 2,
      "name": "family name",
      "datatypeId": "FN"
    },
    {
      "sequence": 3,
      "name": "given name",
      "datatypeId": "ST"
    },
    {
      "sequence": 4,
      "name": "second and further given names or initials thereof",
      "datatypeId": "ST"
    },
    {
      "sequence": 5,
      "name": "suffix (e.g., JR or III)",
      "datatypeId": "ST"
    },
    {
      "sequence": 6,
      "name": "prefix (e.g., DR)",
      "datatypeId": "ST"
    },
    {
      "sequence": 7,
      "name": "degree (e.g., MD)",
      "datatypeId": "IS"
    },
    {
      "sequence": 8,
      "name": "source table",
      "datatypeId": "IS"
    },
    {
      "sequence": 9,
      "name": "assigning authority",
      "datatypeId": "HD"
    },
    {
      "sequence": 10,
      "name": "name type code",
      "datatypeId": "ID"
    },
    {
      "sequence": 11,
      "name": "identifier check digit",
      "datatypeId": "ST"
    },
    {
      "sequence": 12,
      "name": "code identifying the check digit scheme employed",
      "datatypeId": "ID"
    },
    {
      "sequence": 13,
      "name": "identifier type code (IS)",
      "datatypeId": "IS"
    },
    {
      "sequence": 14,
      "name": "assigning facility",
      "datatypeId": "HD"
    },
    {
      "sequence": 15,
      "name": "Name Representation code",
      "datatypeId": "ID"
    },
    {
      "sequence": 16,
      "name": "name context",
      "datatypeId": "CE"
    },
    {
      "sequence": 17,
      "name": "name validity range",
      "datatypeId": "DR"
    },
    {
      "sequence": 18,
      "name": "name assembly order",
      "datatypeId": "ID"
    }
  ]
}
